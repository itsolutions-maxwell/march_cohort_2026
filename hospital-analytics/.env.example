# GCP project that owns the BigQuery datasets
GCP_PROJECT_ID=your-gcp-project-id

# Random long string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me

# Optional: only needed locally if you're not using
# `gcloud auth application-default login`. Points at a service
# account JSON key with BigQuery Data Editor + BigQuery Job User.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
